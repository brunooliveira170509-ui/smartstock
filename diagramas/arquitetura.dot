digraph ARQ {
  graph [rankdir=TB, bgcolor="white", pad=0.5, nodesep=0.6, ranksep=0.7, fontname="Poppins", compound=true, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Poppins", fontsize=12, margin="0.25,0.12", penwidth=1.4];
  edge  [fontname="Poppins", fontsize=10, color="#334155", penwidth=1.3];

  usr [label="👤  Usuário\nGestor(a) · Operador(a)", fillcolor="#F1F5F9", color="#64748B"];

  subgraph cluster_front { label="CAMADA DE APRESENTAÇÃO  (Dia 7)"; style="rounded,dashed"; color="#0F766E"; fontcolor="#0F766E"; fontsize=11;
    fe [label="🖥️  Front-end SPA\nReact + Vite\nTailwind CSS", fillcolor="#CCFBF1", color="#0F766E"]; }

  subgraph cluster_back { label="CAMADA DE NEGÓCIO  (Dia 8)"; style="rounded,dashed"; color="#1E293B"; fontcolor="#1E293B"; fontsize=11;
    api [label="⚙️  API REST\nPython · FastAPI\nJWT · Pydantic · SQLAlchemy", fillcolor="#E2E8F0", color="#1E293B"]; }

  subgraph cluster_data { label="CAMADA DE DADOS  (Dia 8)"; style="rounded,dashed"; color="#1D4ED8"; fontcolor="#1D4ED8"; fontsize=11;
    db [label="🐘  PostgreSQL\nproduto · movimentacao\ntrigger de saldo · view", shape=cylinder, fillcolor="#DBEAFE", color="#1D4ED8"]; }

  subgraph cluster_ia { label="INTEGRAÇÃO FUTURA – AUTOMAÇÃO E IA  (Dia 9)"; style="rounded,dashed"; color="#D97706"; fontcolor="#B45309"; fontsize=11;
    n8n [label="🔁  N8N\nWebhooks · Cron · Fluxos", fillcolor="#FEF3C7", color="#D97706"];
    ia  [label="🧠  Agente de IA (LLM)\nInterpreta perguntas\nSugere compras", fillcolor="#FEF3C7", color="#D97706"];
    msg [label="📲  Telegram / E-mail\nAlertas de reposição", fillcolor="#FEF3C7", color="#D97706"];
  }

  usr -> fe  [label=" navegador "];
  fe  -> api [label=" requisições HTTPS (JSON) "];
  api -> fe  [label=" respostas ", style=dashed, color="#94A3B8"];
  api -> db  [label=" SQL via ORM "];

  api -> n8n [label=" webhook (produto BAIXO)\n consultas à API ", style=dashed, color="#D97706", dir=both];
  n8n -> ia  [style=dashed, color="#D97706", dir=both, label=" pergunta / resposta "];
  n8n -> msg [style=dashed, color="#D97706"];
  fe  -> n8n [label=" chat do assistente ", style=dashed, color="#D97706", constraint=false];
  { rank=same; api; n8n; }
}
